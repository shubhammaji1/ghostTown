{
  "name": "ghosttown-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first synthetic user testing for VS Code and Node.js",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:packaging": "node scripts/smoke.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:vsix": "node scripts/verify-vsix.mjs",
    "test:offline": "vitest run tests/unit tests/integration/offline-browser.test.ts tests/integration/agent.test.ts tests/integration/runner.test.ts tests/integration/studio.test.ts",
    "playground": "node scripts/playground.mjs",
    "cli": "node packages/cli/dist/bin.cjs",
    "browsers:install": "playwright install chromium",
    "package:vsix": "node scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "jszip": "3.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "zod": "4.6.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "7.3.7"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "2.1.2"
    }
  }
}
